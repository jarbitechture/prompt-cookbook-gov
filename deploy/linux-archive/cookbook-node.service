[Unit]
Description=Prompt Cookbook Node service
Documentation=https://github.com/jarbitechture/prompt-cookbook-gov
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=cookbook
Group=cookbook
WorkingDirectory=/opt/cookbook
EnvironmentFile=/opt/cookbook/.env
ExecStart=/usr/bin/node /opt/cookbook/dist/index.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cookbook/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

# Resource caps
MemoryMax=1G
TasksMax=200

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cookbook

[Install]
WantedBy=multi-user.target
