# Prompt Cookbook — Environment Variables
# Copy this file to .env and fill in values
# In Azure App Service, set these in Configuration > Application Settings

# Optional: Vite build-time base path for subpath deployments.
# Set to the IIS application alias (with trailing slash) when the cookbook
# is mounted under a path like https://host/cookbook/. Leave unset for
# root-mount deployments.
# VITE_BASE=/cookbook/

# Civic AI governed proxy (Task #3 — sole LLM backend)
# Base URL of the civic-ai FastAPI proxy (no trailing slash, include /v1 path)
CIVIC_AI_BASE_URL=http://127.0.0.1:8100/v1

# API key for the civic-ai proxy (matches CIVIC_AI_API_KEY on the proxy server)
# Leave blank for open-access dev mode (CIVIC_AI_API_KEY unset on proxy)
CIVIC_AI_API_KEY=

# Default model passed to the proxy (must be available in Ollama / Azure)
CIVIC_AI_DEFAULT_MODEL=phi4

# Optional: Port (defaults to 3000)
PORT=3000

# Optional: Comma-separated SharePoint origins for iframe embedding
# SHAREPOINT_ORIGINS=https://yourtenant.sharepoint.com

# Optional: Set to "1" if behind a reverse proxy / load balancer
# TRUST_PROXY=1
